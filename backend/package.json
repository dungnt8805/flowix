{
  "name": "@flo-vis/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:production": "NODE_ENV=production yarn start:prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:build": "yarn build",
    "migration:generate": "yarn db:build && NODE_OPTIONS='-r dotenv/config' npx typeorm migration:generate -d dist/database/postgres/data-source.js",
    "migration:run": "yarn db:build && NODE_OPTIONS='-r dotenv/config' npx typeorm migration:run -d dist/database/postgres/data-source.js",
    "migration:revert": "yarn db:build && NODE_OPTIONS='-r dotenv/config' npx typeorm migration:revert -d dist/database/postgres/data-source.js",
    "migration:show": "yarn db:build && NODE_OPTIONS='-r dotenv/config' npx typeorm migration:show -d dist/database/postgres/data-source.js",
    "migration:create": "NODE_OPTIONS='-r dotenv/config' npx typeorm migration:create",
    "m:gen": "yarn migration:generate",
    "m:run": "yarn migration:run",
    "m:revert": "yarn migration:revert",
    "m:show": "yarn migration:show",
    "m:create": "yarn migration:create",
    "test:migrations": "bash test-migrations.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}

